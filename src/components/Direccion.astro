---
// src/components/Direccion.astro
// Dónde es: el lugar, la foto de la casa, la hora y el botón del mapa.
import { partesFecha } from "../utils/evento";

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Ubicación";
const texto = "Te espero en";
const lugar = "Mi domicilio particular";
/* Calle y número. Mientras esté vacío, la línea no se muestra */
const direccion = "";
/* Foto del lugar (comprimida, menos de 300 KB). Vacía: no se muestra */
const foto = { src: "/imagenes/domicilio.webp", alt: "Frente del domicilio" };
/*
   Enlace de Google Maps que manda el cliente (maps.app.goo.gl/...).
   Mientras esté vacío, el botón no se muestra.
*/
const enlaceMapa = "https://maps.app.goo.gl/EtYftWbEbfdiyd7K9";
const textoBoton = "Ver ubicación";
// ──────────────────────────────────────────────────────────────
---

<section id="direccion" class="hoja">
    <h2 class="titulo-seccion">{titulo}</h2>
    <p class="rotulo bajada">{texto}</p>
    <span class="divisor-vino" aria-hidden="true"></span>

    <!-- Marcador de mapa vino -->
    <svg class="pin" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 22s7-6.4 7-12a7 7 0 1 0-14 0c0 5.6 7 12 7 12z" fill="#8e1622" />
        <circle cx="12" cy="10" r="2.6" fill="#fbf4ec" />
    </svg>

    <p class="lugar">{lugar}</p>
    {direccion && <p class="texto domicilio">{direccion}</p>}

    {
        foto.src && (
            <figure class="foto">
                <img src={foto.src} alt={foto.alt} width="760" height="428" loading="lazy" />
            </figure>
        )
    }

    <p class="rotulo hora">{partesFecha.hora} hrs</p>

    {
        enlaceMapa && (
            <a class="boton-vino boton" href={enlaceMapa} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 4 3 6.5v13.5l6-2.5 6 2.5 6-2.5V4l-6 2.5z" />
                    <path d="M9 4v13.5M15 6.5V20" />
                </svg>
                {textoBoton}
            </a>
        )
    }
</section>

<style>
    /* Textos de esta sección más grandes: se leen en el celular */
    .bajada {
        margin-top: 0.6svh;
        font-size: clamp(0.92rem, 4.2vw, 1.05rem);
        font-weight: 600;
    }

    .pin {
        width: 38px;
        height: 38px;
        margin: 1svh 0 1.4svh;
        filter: drop-shadow(0 4px 6px rgba(58, 7, 13, 0.25));
    }

    .lugar {
        margin: 0;
        font-family: "Playfair Display", Georgia, serif;
        font-weight: 700;
        font-size: clamp(1.3rem, 6.2vw, 1.6rem);
        line-height: 1.3;
        color: var(--vino-oscuro);
    }

    .domicilio {
        margin-top: 0.8svh;
    }

    /* La foto de la casa, con marco perla fino y sombra suave */
    .foto {
        width: 106%;
        margin: 2.4svh 0 0;
        padding: 5px;
        border-radius: 12px;
        background-image: linear-gradient(#fffaf4, #fffaf4);
        box-shadow:
            0 0 0 1px rgba(91, 15, 24, 0.35),
            0 10px 22px rgba(58, 7, 13, 0.2);
    }

    .foto img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 8px;
    }

    .hora {
        margin-top: 2.2svh;
        font-size: clamp(1.05rem, 4.9vw, 1.2rem);
        font-weight: 700;
    }

    .boton {
        margin-top: 3.4svh;
    }
</style>

<script>
    import { entrarAlHacerScroll } from "../utils/entradas";

    document.addEventListener("DOMContentLoaded", () => {
        const q = (s: string) => document.querySelector(`#direccion ${s}`);
        entrarAlHacerScroll(q(".titulo-seccion"), "abajo", { retraso: 0.15 });
        entrarAlHacerScroll(q(".bajada"), "abajo", { retraso: 0.3 });
        entrarAlHacerScroll(q(".divisor-vino"), "zoom", { retraso: 0.4 });
        entrarAlHacerScroll(q(".pin"), "abajo", { retraso: 0.5 });
        entrarAlHacerScroll(q(".lugar"), "izquierda", { retraso: 0.6 });
        entrarAlHacerScroll(q(".domicilio"), "derecha", { retraso: 0.7 });
        entrarAlHacerScroll(q(".foto"), "zoom", { retraso: 0.2 });
        entrarAlHacerScroll(q(".hora"), "abajo", { retraso: 0.8 });
        entrarAlHacerScroll(q(".boton"), "zoom", { retraso: 0.95 });
    });
</script>

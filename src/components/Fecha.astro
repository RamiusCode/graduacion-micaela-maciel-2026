---
// src/components/Fecha.astro
// La fecha, en el estilo clásico de las invitaciones: el mes arriba, y
// en una fila el día de la semana | el número grande | la hora, con el
// año debajo. La fecha sale de utils/evento.ts (la misma del contador).
import { partesFecha } from "../utils/evento";

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Reserva la fecha";
const texto = "Acompáñame a celebrar mi graduación";
// ──────────────────────────────────────────────────────────────
---

<section id="fecha" class="hoja">
    <h2 class="titulo-seccion">{titulo}</h2>
    <p class="rotulo bajada">{texto}</p>

    <div class="calendario">
        <p class="mes">{partesFecha.mes}</p>
        <div class="fila">
            <span class="lado">{partesFecha.diaSemana}</span>
            <span class="numero">{partesFecha.dia}</span>
            <span class="lado">{partesFecha.hora} hrs</span>
        </div>
        <p class="anio">{partesFecha.anio}</p>
    </div>
</section>

<style>
    .bajada {
        margin-top: 0.6svh;
    }

    .calendario {
        width: 100%;
        margin-top: 4svh;
    }

    .mes {
        margin: 0;
        font-family: "Playfair Display", Georgia, serif;
        font-weight: 600;
        font-size: clamp(1.05rem, 5vw, 1.35rem);
        text-transform: uppercase;
        letter-spacing: 0.3em;
        /* el espaciado agrega aire a la derecha: se compensa */
        padding-left: 0.3em;
        color: var(--vino);
    }

    /* Los dos costados estirados a la misma altura: si la hora baja a dos
       renglones, el recuadro del día crece igual y quedan parejos */
    .fila {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: stretch;
        gap: 3%;
        margin: 1.4svh 0;
    }

    .lado {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.7em 0;
        border-top: 1px solid rgba(91, 15, 24, 0.55);
        border-bottom: 1px solid rgba(91, 15, 24, 0.55);
        font-family: "Playfair Display", Georgia, serif;
        font-weight: 700;
        /* Grande para el celular; con poco espaciado entre letras para que
           entre al costado del número. Si igual no entra, baja de renglón
           dentro de sus líneas (no se achica) */
        font-size: clamp(0.98rem, 4.5vw, 1.15rem);
        line-height: 1.25;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--vino-oscuro);
    }

    .numero {
        align-self: center;
        font-family: "Playfair Display", Georgia, serif;
        font-weight: 700;
        font-variant-numeric: lining-nums;
        font-size: clamp(3.6rem, 18vw, 4.8rem);
        line-height: 1;
        color: var(--rojo);
    }

    .anio {
        margin: 0;
        font-family: "Playfair Display", Georgia, serif;
        font-weight: 600;
        font-size: clamp(1.05rem, 5vw, 1.35rem);
        letter-spacing: 0.3em;
        padding-left: 0.3em;
        color: var(--vino);
    }
</style>

<script>
    import { entrarAlHacerScroll } from "../utils/entradas";

    document.addEventListener("DOMContentLoaded", () => {
        const q = (s: string) => document.querySelector(`#fecha ${s}`);
        const lados = document.querySelectorAll("#fecha .lado");
        entrarAlHacerScroll(q(".titulo-seccion"), "abajo", { retraso: 0.15 });
        entrarAlHacerScroll(q(".bajada"), "abajo", { retraso: 0.3 });
        entrarAlHacerScroll(q(".mes"), "abajo", { retraso: 0.45 });
        entrarAlHacerScroll(lados[0], "izquierda", { retraso: 0.6 });
        entrarAlHacerScroll(q(".numero"), "zoom", { retraso: 0.6 });
        entrarAlHacerScroll(lados[1], "derecha", { retraso: 0.6 });
        entrarAlHacerScroll(q(".anio"), "abajo", { retraso: 0.8 });
    });
</script>

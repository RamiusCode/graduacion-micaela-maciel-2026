---
// src/components/Vestimenta.astro
// Código de vestimenta: el título en una sola línea, un pedido sobre los
// colores y dos círculos con los colores a evitar.

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Código de vestimenta";
const nota = "Con cariño, te pido evitar los colores guindo y perla.";
const colores = [
    { nombre: "Guindo", color: "#5b0f18" },
    { nombre: "Perla", color: "#f3e6d8" },
];
// ──────────────────────────────────────────────────────────────
---

<section id="vestimenta" class="hoja">
    <h2 class="titulo-seccion titulo">{titulo}</h2>
    <span class="divisor-vino" aria-hidden="true"></span>

    <p class="nota">{nota}</p>

    <ul class="colores">
        {
            colores.map((c) => (
                <li>
                    <span class="circulo" style={`background-image: linear-gradient(${c.color}, ${c.color})`} />
                    <span class="nombre-color">{c.nombre}</span>
                </li>
            ))
        }
    </ul>
</section>

<style>
    /* Más chico que los otros títulos para que entre en una sola línea */
    .titulo {
        font-size: clamp(2rem, 9.2vw, 2.6rem);
        white-space: nowrap;
    }

    .nota {
        margin: 0.6svh 0 0;
        font-family: "Playfair Display", Georgia, serif;
        font-style: italic;
        font-weight: 500;
        font-size: clamp(0.95rem, 4.3vw, 1.1rem);
        line-height: 1.6;
        color: var(--vino-oscuro);
    }

    /* Los colores a evitar: círculos con borde dorado */
    .colores {
        display: flex;
        justify-content: center;
        gap: 8vw;
        margin: 2svh 0 0;
        padding: 0;
        list-style: none;
    }

    .colores li {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.8svh;
    }

    .circulo {
        width: clamp(52px, 15vw, 62px);
        aspect-ratio: 1;
        border-radius: 50%;
        border: 2px solid var(--dorado);
        box-shadow: 0 6px 12px rgba(58, 7, 13, 0.18);
    }

    .nombre-color {
        font-family: "Playfair Display", Georgia, serif;
        font-weight: 600;
        font-size: clamp(0.8rem, 3.6vw, 0.92rem);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--vino);
    }
</style>

<script>
    import { entrarAlHacerScroll } from "../utils/entradas";

    document.addEventListener("DOMContentLoaded", () => {
        const q = (s: string) => document.querySelector(`#vestimenta ${s}`);
        entrarAlHacerScroll(q(".titulo-seccion"), "abajo", { retraso: 0.15 });
        entrarAlHacerScroll(q(".divisor-vino"), "zoom", { retraso: 0.3 });
        entrarAlHacerScroll(q(".nota"), "abajo", { retraso: 0.45 });
        entrarAlHacerScroll(q(".colores"), "zoom", { retraso: 0.7 });
    });
</script>
